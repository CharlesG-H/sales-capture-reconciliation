# Copy to .env and fill in real values. NEVER commit .env.

# Bot token from @BotFather (Telegram)
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-here

# Path to the Google service account JSON key (keep it in this folder; it is gitignored)
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# Target spreadsheet ID (from the sheet URL between /d/ and /edit)
SPREADSHEET_ID=your-spreadsheet-id-here

# The one Telegram group the bot listens to (supergroup ID, starts with -100).
# Leave blank for now; scripts/check_setup.py will help you find it.
ALLOWED_CHAT_ID=

# --- Cloud Run (webhook) mode — leave all three blank for local polling ---
# Public HTTPS URL of the Cloud Run service. When set, the bot serves a
# webhook instead of polling, and topic state lives in the spreadsheet's
# hidden "Bot State" tab instead of topic_names.json.
WEBHOOK_URL=
# Random string Telegram echoes back on every webhook call; requests without
# it are rejected. Required whenever WEBHOOK_URL is set.
WEBHOOK_SECRET_TOKEN=
# Cloud Run injects PORT automatically; override only for local webhook tests.
# PORT=8080
